# このファイルをコピーして keystore.properties にリネームし、パスワードを入れてください。
#   cp keystore.properties.sample keystore.properties
# keystore.properties は .gitignore 済みです。コミットしないでください。

storeFile=/Users/hirayamamasaki/Desktop/SKart/その他/Key.jks
storePassword=
keyAlias=key0
keyPassword=

# keyAlias は公開済み AAB の署名ブロック（META-INF/KEY0.SF）から key0 と推定。
# 違っていたら次のコマンドで確認できます（ストアのパスワードを聞かれます）:
#   keytool -list -v -keystore "/Users/hirayamamasaki/Desktop/SKart/その他/Key.jks"
